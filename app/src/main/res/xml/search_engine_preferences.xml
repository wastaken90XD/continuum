<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontListPreference
        app:defaultValue="FOURGET"
        app:entries="@array/settings_search_engine_entries"
        app:entryValues="@array/settings_search_engine_values"
        app:key="primary_engine"
        app:title="@string/settings_search_engine_primary_title"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontListPreference
        app:defaultValue="REDDIT_NATIVE"
        app:entries="@array/settings_search_fallback_engine_entries"
        app:entryValues="@array/settings_search_fallback_engine_values"
        app:key="fallback_engine"
        app:title="@string/settings_search_engine_fallback_title"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreferenceCategory
        app:title="@string/settings_fourget_group" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontEditTextPreference
        android:defaultValue="https://4get.ca"
        android:key="fourget_instance_url"
        android:title="@string/settings_fourget_instance_url_title"
        android:summary="@string/settings_fourget_instance_url_summary"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontEditTextPreference
        android:defaultValue="100"
        android:inputType="number"
        android:key="captcha_budget"
        android:title="@string/settings_fourget_captcha_budget_title"
        android:summary="@string/settings_fourget_captcha_budget_summary"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="captcha_solved_now"
        app:title="@string/settings_fourget_captcha_solved_now_title"
        app:summary="@string/settings_fourget_captcha_solved_now_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreferenceCategory
        app:title="@string/settings_google_cse_group" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontEditTextPreference
        android:key="google_cse_api_key"
        android:title="@string/settings_google_cse_api_key_title"
        android:summary="@string/tap_to_set_value"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontEditTextPreference
        android:key="google_cse_cx"
        android:title="@string/settings_google_cse_cx_title"
        android:summary="@string/settings_google_cse_summary" />

</androidx.preference.PreferenceScreen>
